---
import Base from '../layouts/Base.astro';
import { u, telHref } from '../lib/paths';
import { firm, lawyer, office, peer } from '../content/site';

const photoSrc = lawyer.photo ? u(`/images/${lawyer.photo}`) : '';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${lawyer.name}${lawyer.role}`,
  jobTitle: '律師',
  worksFor: { '@type': 'Attorney', name: firm.name },
  telephone: lawyer.tel,
  email: lawyer.email,
  knowsLanguage: lawyer.languages,
  alumniOf: lawyer.education.map((e) => ({ '@type': 'EducationalOrganization', name: e })),
  memberOf: { '@type': 'Organization', name: lawyer.bar },
};
---

<Base
  title={`${lawyer.name}律師`}
  description={`${firm.name}｜${lawyer.name}律師，${lawyer.bar}會員，律師證書字號${lawyer.licenseNo}。畢業於國立政治大學法律學系，在臺南執業逾三十年。`}
  current="profile"
  jsonLd={personLd}
>
  <section class="profile-hero">
    <div class="wrap profile-hero__inner">
      <div>
        <p class="hero__eyebrow">{firm.name}</p>
        <h1 class="profile-hero__name" aria-label={`${lawyer.name}律師`}>
          <span>{lawyer.name}</span><span class="role">{lawyer.role}</span>
        </h1>
        <p class="profile-hero__tagline">{lawyer.tagline}</p>
        <div class="profile-hero__actions">
          <a class="btn btn--onDeep" href={telHref(lawyer.tel)}>{lawyer.tel}</a>
          <a class="btn btn--onDeep" href={`mailto:${lawyer.email}`}>來信洽詢</a>
        </div>
        <p class="mail-note">來信僅供初步聯繫，未經面談與委任契約不成立委任關係，請勿先傳送機密資料。</p>
      </div>
      <div class="profile-hero__portrait">
        {photoSrc
          ? <img src={photoSrc} alt={`${lawyer.name}律師`} width="520" height="650" />
          : <div class="portrait-placeholder" aria-hidden="true"><span>{lawyer.name}</span><small>照片預留位置</small></div>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap profile-grid">
      <div>
        <p class="eyebrow">Profile</p>
        <h2 class="section-title">關於{lawyer.name}律師</h2>
        <div class="rule"></div>
        {lawyer.intro.map((p) => <p class="profile-para">{p}</p>)}

        <h3 class="sub-h">主要承辦領域</h3>
        <ul class="tags">{lawyer.practiceAreas.map((a) => <li>{a}</li>)}</ul>
        <p style="margin-top:1rem">
          <a class="card__link" href={u('/services/')}>各領域的詳細說明 →</a>
        </p>
      </div>

      <aside class="profile-side">
        <h3>學歷</h3>
        <ul class="plain">{lawyer.education.map((e) => <li>{e}</li>)}</ul>

        <h3>經歷</h3>
        <ul class="plain">{lawyer.career.map((c) => <li>{c}</li>)}</ul>

        {lawyer.current.length > 0 && (
          <>
            <h3>現任</h3>
            <ul class="plain">{lawyer.current.map((c) => <li>{c}</li>)}</ul>
          </>
        )}

        <h3>執業資格</h3>
        <dl class="dl">
          <div><dt>律師證書</dt><dd>{lawyer.licenseNo}</dd></div>
          <div><dt>所屬公會</dt><dd>{lawyer.bar}</dd></div>
          <div><dt>語言</dt><dd>{lawyer.languages.join('、')}</dd></div>
        </dl>

        <h3>聯絡</h3>
        <dl class="dl">
          <div><dt>事務所</dt><dd>{firm.name}</dd></div>
          <div><dt>地址</dt><dd>{office.addressFull}</dd></div>
          <div><dt>電話</dt><dd><a href={telHref(lawyer.tel)}>{lawyer.tel}</a></dd></div>
          <div><dt>傳真</dt><dd>{lawyer.fax}</dd></div>
          <div><dt>電子郵件</dt><dd><a href={`mailto:${lawyer.email}`}>{lawyer.email}</a></dd></div>
          <div><dt>服務時間</dt><dd>{office.hours}</dd></div>
        </dl>

        <p class="source-note">
          律師證書字號、所屬公會與執業狀態，可於
          <a href="https://lawyerbc.moj.gov.tw/" target="_blank" rel="noopener noreferrer">法務部律師查詢系統</a>
          查證。
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--paper2 section--tight">
    <div class="wrap">
      <p class="notice">
        {office.disclaimer}
        若您的問題屬於{peer.areas}，也可以直接聯繫
        <a href={peer.url}>{peer.firmName}</a>。
      </p>
      <p style="margin-top:2rem">
        <a class="btn btn--solid" href={u('/contact/')}>聯絡與交通</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .profile-hero {
    background: linear-gradient(160deg, var(--deep) 0%, #0f241f 100%);
    color: var(--paper);
  }
  .profile-hero__inner {
    display: grid; gap: 2.5rem; align-items: center;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }
  .profile-hero__name {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    letter-spacing: 0.16em;
    margin-bottom: 1.2rem;
  }
  .profile-hero__name .role {
    font-size: 0.32em; letter-spacing: 0.3em;
    margin-left: 0.7em; color: var(--accent-soft); vertical-align: 0.35em;
  }
  .profile-hero__tagline { color: rgba(247, 244, 237, 0.82); max-width: 30em; margin-bottom: 2rem; }
  .profile-hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; }
  .mail-note {
    margin-top: 1.1rem; font-size: 0.78rem; line-height: 1.8;
    color: rgba(247, 244, 237, 0.55); max-width: 30em;
  }
  .profile-hero__portrait { max-width: 320px; }
  .profile-hero__portrait img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .portrait-placeholder {
    aspect-ratio: 4 / 5;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.7rem;
    border: 1px solid rgba(201, 168, 112, 0.35);
    color: var(--accent-soft);
  }
  .portrait-placeholder span {
    font-family: var(--serif); font-size: 2.4rem;
    letter-spacing: 0.3em; text-indent: 0.3em;
  }
  .portrait-placeholder small { font-size: 0.68rem; letter-spacing: 0.2em; opacity: 0.55; }
  @media (min-width: 860px) {
    .profile-hero__inner { grid-template-columns: 1.5fr 1fr; gap: 4rem; }
  }

  .profile-grid { display: grid; gap: 3.5rem; }
  @media (min-width: 900px) { .profile-grid { grid-template-columns: 1.5fr 1fr; gap: 4.5rem; } }

  .profile-para { margin-bottom: 1.4rem; color: var(--ink-2); }
  .sub-h { font-size: 1rem; letter-spacing: 0.14em; margin: 2.4rem 0 1rem; }

  .profile-side {
    background: var(--paper-2);
    border: 1px solid var(--line-soft);
    padding: 2rem;
    align-self: start;
  }
  .profile-side h3 {
    font-size: 0.78rem; letter-spacing: 0.24em;
    color: var(--accent); margin: 2rem 0 0.7rem;
  }
  .profile-side h3:first-child { margin-top: 0; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li { font-size: 0.95rem; padding-block: 0.2rem; }
  .source-note {
    margin-top: 2rem; padding-top: 1.2rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.78rem; color: var(--ink-3); line-height: 1.9;
  }
</style>
